# Desenvolvimento local: DEBUG=True e SQLite são usados por padrão.
# Nunca coloque valores reais neste arquivo nem faça commit de .env.
DEBUG=True
SECRET_KEY=gere-uma-chave-local-segura
ALLOWED_HOSTS=localhost,127.0.0.1

# Para PostgreSQL, descomente e informe sua URL.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Para SMTP (necessário para recuperação de senha fora do ambiente local):
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-usuario
# EMAIL_HOST_PASSWORD=seu-token-smtp
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Instituto Vitta <nao-responda@seudominio.com>
